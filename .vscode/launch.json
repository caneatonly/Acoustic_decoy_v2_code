{
    "version": "0.2.0",
    "configurations": [
        // =================================================================================
        // 新增配置：使用 nanoDAP-wireless 无线调试器
        // =================================================================================
        {
            "name": "Debug with nanoDAP-wireless (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "executable": "${command:cmake.launchTargetPath}",
            "device": "STM32F103RCTx", // 请确保这里的MCU型号与您的一致
            "runToEntryPoint": "main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F103.svd",
            // --- OpenOCD 关键配置 ---
            "configFiles": [
                "interface/cmsis-dap.cfg",  // 指定使用 CMSIS-DAP 接口
                "target/stm32f1x.cfg"       
            ],
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb"
        },
        // =================================================================================
        // 您原有的 ST-Link 调试配置 (已保留)
        // =================================================================================
        {
            "name": "Debug - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "servertype": "stlink",
            "device": "STM32F103RCTx",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F103.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            // 禁用自动Flash下载，使用task烧录后再调试
            "preLaunchTask": "",
            // ST-Link服务器参数
            "serverArgs": [
                "-m", "0"
            ],
            // 禁用GDB自动下载程序到Flash
            "loadFiles": [],
            // SWO配置
            "swoConfig": {
                "enabled": false
            },
            // 显示详细调试输出
            "showDevDebugOutput": "parsed"
        },
        // =================================================================================
        // 新增：先烧录再调试配置（完整流程）
        // =================================================================================
        {
            "name": "Flash & Debug - ST-Link (Full)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "servertype": "stlink",
            "device": "STM32F103RCTx",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F103.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            // 不使用preLaunchTask，让cortex-debug自己通过GDB下载程序
            // 这样可以确保设备处于正确的调试状态
            "serverArgs": [
                "-m", "0"
            ],
            // 显示详细调试输出
            "showDevDebugOutput": "both"
        },
        // =================================================================================
        // 您原有的 ST-Link Attach 配置 (已保留)
        // =================================================================================
        {
            "name": "Attach to Microcontroller - ST-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "attach",
            "servertype": "stlink",
            "device": "STM32F103RCTx",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",
            "svdFile": "${config:STM32VSCodeExtension.cubeCLT.path}/STMicroelectronics_CMSIS_SVD/STM32F103.svd",
            "v1": false,
            "serverpath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${config:STM32VSCodeExtension.cubeCLT.path}/STM32CubeProgrammer/bin",
            "stlinkPath": "${config:STM32VSCodeExtension.cubeCLT.path}/STLink-gdb-server/bin/ST-LINK_gdbserver",
            "armToolchainPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${config:STM32VSCodeExtension.cubeCLT.path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            // Attach模式：不下载程序，只连接到正在运行的MCU
            "serverArgs": [
                "-m", "0",       // 连接模式
                "--attach"       // Attach模式，不复位
            ]
        }
    ]
}